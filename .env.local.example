# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Painel do Supabase > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# E-mails transacionais (Resend > API Keys)
RESEND_API_KEY=re_xxxxxxxx

# Confirmação de fornecedores (módulo de e-mail)
# Service role key: Painel do Supabase > Settings > API > service_role (secreta!)
SUPABASE_SERVICE_ROLE_KEY=
# Qualquer string aleatória longa — protege a rota /api/cron/confirmacoes
CRON_SECRET=
# URL pública do app (usada nos links dos e-mails). Em dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Remetente dos e-mails. Sem domínio verificado no Resend, use o padrão
# onboarding@resend.dev (só entrega para o e-mail da conta Resend).
EMAIL_FROM=Vela <onboarding@resend.dev>

# ------------------------------------------------------------------
# WhatsApp Business Cloud API (Meta) — SERVER-SIDE, nunca no navegador
# ------------------------------------------------------------------
# Sem estas duas, todo o canal degrada em silêncio: o sistema continua
# funcionando e nada é enviado por WhatsApp.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token de verificação do webhook (você escolhe; repete no painel da Meta)
WHATSAPP_VERIFY_TOKEN=

# Lembrete de prazo da cerimonialista. E mensagem INICIADA pelo negocio,
# fora da janela de 24h - a Meta so entrega TEMPLATE aprovado. Crie no
# WhatsApp Manager, categoria UTILITY (nao Marketing), idioma pt_BR, com
# cinco variaveis no corpo, nesta ordem:
#
#   Ola, {{1}}! {{2}} voce tem {{3}}.
#   {{4}}
#   Abra {{5}} para ver os detalhes.
#
#   {{1}} primeiro nome        ex.: Luana
#   {{2}} quando               ex.: Amanha (19/09) | Hoje (18/09) | Hoje e amanha
#   {{3}} quantas              ex.: 1 tarefa | 4 tarefas
#   {{4}} a tarefa que lidera  ex.: A primeira: Fechar o cardapio - Ana e Caio
#   {{5}} link                 ex.: https://seu-app/tarefas
#
# Repare que o corpo COMECA e TERMINA com texto, nunca com variavel: a
# Meta recusa "dangling parameter" e o template nem chega a ser criado.
#
# Deixe VAZIO enquanto o template nao estiver aprovado. Sem nome aqui, o
# canal fica desligado e so o sino e enviado - o token da Meta ja existe
# muito antes do template, e um nome chutado faria a rotina tomar erro
# 132001 todo dia, em silencio.
WHATSAPP_TEMPLATE_LEMBRETE=
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
